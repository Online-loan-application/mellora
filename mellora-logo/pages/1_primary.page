pageType: content
background: {type: solid, color: "$butter"}
elements:
  - elementId: brand-label
    elementType: text
    bounds: [64, 54, 400, 30]
    content:
      style: "$label"
      color: "$green"
      bold: true
      wrap: false
      align: [left, middle]
      text: MELLORA / DIGITAL BANKING
  - elementId: page-label
    elementType: text
    bounds: [716, 54, 300, 30]
    content:
      style: "$label"
      color: "$green"
      wrap: false
      align: [right, middle]
      text: 01 — PRIMARY LOGO
  - elementId: icon-bg
    elementType: shape
    bounds: [202, 385, 190, 190]
    shapeName: roundRect
    adjustments: [26000]
    fill: {type: solid, color: "$green"}
  - elementId: icon-m
    elementType: shape
    bounds: [238, 425, 118, 112]
    shapeName: custom
    viewBox: [240, 240]
    path: "M34,206 L34,63 Q34,34 63,34 Q79,34 92,48 L120,79 L148,48 Q161,34 177,34 Q206,34 206,63 L206,206 L163,206 L163,117 L137,145 Q120,162 103,145 L77,117 L77,206 Z"
    fill: {type: solid, color: "$butter"}
  - elementId: wordmark
    elementType: text
    bounds: [432, 397, 460, 142]
    content:
      fontFamily: Sora
      fontSize: 88
      bold: true
      color: "$green"
      letterSpacing: -4
      wrap: false
      align: [left, middle]
      text: mellora
  - elementId: tagline
    elementType: text
    bounds: [290, 626, 500, 40]
    content:
      style: "$tagline"
      color: "$green"
      wrap: false
      align: [center, middle]
      text: Money, made mellow.
  - elementId: divider
    elementType: shape
    bounds: [490, 714, 100, 4]
    shapeName: roundRect
    adjustments: [50000]
    fill: {type: solid, color: "$green"}
  - elementId: butter-chip
    elementType: shape
    bounds: [64, 948, 42, 42]
    shapeName: ellipse
    fill: {type: solid, color: "$butter"}
    border: {style: solid, width: 2, color: "$green"}
  - elementId: butter-hex
    elementType: text
    bounds: [120, 952, 180, 34]
    content: {fontFamily: DM Sans, fontSize: 18, color: "$green", wrap: false, align: [left, middle], text: "#FFEFB3  BUTTER"}
  - elementId: green-chip
    elementType: shape
    bounds: [790, 948, 42, 42]
    shapeName: ellipse
    fill: {type: solid, color: "$green"}
  - elementId: green-hex
    elementType: text
    bounds: [846, 952, 180, 34]
    content: {fontFamily: DM Sans, fontSize: 18, color: "$green", wrap: false, align: [left, middle], text: "#013E37  GREEN"}
