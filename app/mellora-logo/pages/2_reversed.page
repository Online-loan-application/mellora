    elementType: text
    bounds: [64, 54, 400, 30]
    content:
      style: "$label"
      color: "$butter"
      bold: true
      wrap: false
      align: [left, middle]
      text: MELLORA / DIGITAL BANKING
  - elementId: page-label
    elementType: text
    bounds: [696, 54, 320, 30]
